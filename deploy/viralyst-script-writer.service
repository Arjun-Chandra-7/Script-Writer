[Unit]
Description=Viralyst Script Writer Drive watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory="/home/xor_sensei/Dev/Viralyst/Script Writer"
EnvironmentFile="/home/xor_sensei/Dev/Viralyst/Script Writer/.env"
ExecStart="/home/xor_sensei/Dev/Viralyst/Script Writer/.venv/bin/script-writer" watch
Restart=on-failure
RestartSec=15
TimeoutStopSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths="/home/xor_sensei/Dev/Viralyst/Script Writer/state"

[Install]
WantedBy=default.target

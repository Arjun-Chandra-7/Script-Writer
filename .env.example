# The folder in the URL supplied for this project.
SCRIPT_WRITER_DRIVE_FOLDER_ID=1loe1nchN4PFqkTzujZmbkB31E_DpCwqE

# Share the folder with the service-account email as Viewer, then place the key
# at this ignored path. Never commit the key.
SCRIPT_WRITER_GOOGLE_CREDENTIALS=credentials/google-service-account.json

# Durable DB, raw reports, and manifests. Back this directory up.
SCRIPT_WRITER_STATE_DIR=state
SCRIPT_WRITER_POLL_SECONDS=60
SCRIPT_WRITER_MAX_FILE_BYTES=16777216
SCRIPT_WRITER_LEASE_SECONDS=900

# Fixed forever after the first dataset is created.
SCRIPT_WRITER_SPLIT_SALT=viralyst-script-writer-v1

# Historical training-manifest settings are intentionally omitted. The watcher
# only ingests, compiles Script Intelligence, and updates the local index.
SCRIPT_WRITER_AUTO_PROPOSE_RUN=false
